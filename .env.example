# Copy to .env.local for local overrides (never commit secrets).
# Localhost Photos uploads do NOT need a PAT — the disk is writable.
#
# Optional — only for live www saves / GitHub push helpers:
# Classic personal access token with "repo" scope.
# ANVI_GITHUB_TOKEN=ghp_xxxxxxxx
# GITHUB_TOKEN=ghp_xxxxxxxx
#
# Optional GitHub target (defaults match production repo):
# ANVI_GITHUB_OWNER=dpanvigrand-sys
# ANVI_GITHUB_REPO=anvi-grand
# ANVI_GITHUB_BRANCH=main
